{
  "name": "venos",
  "displayName": "Venos",
  "description": "Syntax highlighting for the Venos programming language (.my)",
  "version": "0.6.0",
  "publisher": "vpdrla",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Vpdrla/Venos"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "venos",
        "aliases": [
          "Venos",
          "venos"
        ],
        "extensions": [
          ".my"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "venos",
        "scopeName": "source.venos",
        "path": "./syntaxes/venos.tmLanguage.json"
      }
    ]
  }
}
