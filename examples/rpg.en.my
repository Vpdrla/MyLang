# ================================================
#  Dungeon of Venos — a text RPG in Venos (English)
#  (examples/rpg.my is the same game with Korean identifiers)
# ================================================

class Player {
    func init(name) {
        self.name = name
        self.level = 1
        self.exp = 0
        self.maxhp = 50
        self.hp = 50
        self.atk = 8
        self.gold = 30
        self.potions = 2
    }
    func stats() {
        print ""
        print "===== {self.name} (Lv.{self.level}) ====="
        print "HP: {self.hp}/{self.maxhp}   ATK: {self.atk}"
        print "Gold: {self.gold}   Potions: {self.potions}   EXP: {self.exp}/{self.level * 20}"
    }
    func attack_roll() {
        # random between 80% and 120% of ATK
        return random(round(self.atk * 0.8), round(self.atk * 1.2))
    }
    func drink_potion() {
        if self.potions <= 0 {
            print ">> No potions left!"
            return false
        }
        self.potions -= 1
        let heal = 30
        self.hp = min(self.hp + heal, self.maxhp)
        print ">> You drink a potion! +{heal} HP → {self.hp}/{self.maxhp}"
        return true
    }
    func gain_exp(amount) {
        self.exp += amount
        while self.exp >= self.level * 20 {
            self.exp -= self.level * 20
            self.level += 1
            self.maxhp += 15
            self.atk += 3
            self.hp = self.maxhp
            print ""
            print "** LEVEL UP! Lv.{self.level} (HP/ATK up, fully healed) **"
        }
    }
    func save_game() {
        let data = self.name + "," + self.level + "," + self.exp + "," + self.maxhp
        data = data + "," + self.hp + "," + self.atk + "," + self.gold + "," + self.potions
        writefile("save.txt", data)
        print ">> Saved! (save.txt)"
    }
}

class Monster {
    func init(template, boost) {
        self.name = template["name"]
        self.hp = template["hp"] + boost * 8
        self.atk = template["atk"] + boost * 2
        self.gold = template["gold"] + boost * 5
        self.exp = template["exp"] + boost * 4
    }
    func attack_roll() {
        return random(round(self.atk * 0.7), round(self.atk * 1.3))
    }
}

func spawn_monster(level) {
    let bestiary = [
        {"name": "Sticky Slime", "hp": 22, "atk": 4,  "gold": 8,  "exp": 7},
        {"name": "Cave Goblin",  "hp": 32, "atk": 6,  "gold": 14, "exp": 12},
        {"name": "Ash Wolf",     "hp": 42, "atk": 9,  "gold": 22, "exp": 18},
        {"name": "Mine Orc",     "hp": 55, "atk": 12, "gold": 34, "exp": 26}
    ]
    let boost = level - 1
    let pick = random(1, min(len(bestiary), level + 1))
    return Monster(bestiary[pick], boost)
}

# battle: returns true on victory, false on flee/death
func battle(p, m) {
    print ""
    print "!!! A wild {m.name} appears! (HP {m.hp} / ATK {m.atk})"
    while true {
        print ""
        print "[1] Attack  [2] Potion ({p.potions} left)  [3] Run"
        let choice = input "> "
        if choice == 1 {
            let dmg = p.attack_roll()
            m.hp -= dmg
            print ">> You hit the {m.name} for {dmg}! (HP left: {max(m.hp, 0)})"
            if m.hp <= 0 {
                print ""
                print ">> The {m.name} is defeated! +{m.gold} gold, +{m.exp} exp"
                p.gold += m.gold
                p.gain_exp(m.exp)
                return true
            }
        } else if choice == 2 {
            if not p.drink_potion() { continue }   # no potion → keep your turn
        } else if choice == 3 {
            if random(1, 100) <= 50 {
                print ">> You got away safely!"
                return false
            }
            print ">> Couldn't escape!"
        } else {
            print ">> Pick 1, 2 or 3"
            continue
        }
        # the monster strikes back
        let hit = m.attack_roll()
        p.hp -= hit
        print ">> The {m.name} hits you for {hit}! (Your HP: {max(p.hp, 0)}/{p.maxhp})"
        if p.hp <= 0 { return false }
    }
}

func shop(p) {
    while true {
        print ""
        print "===== Shop ===== (your gold: {p.gold})"
        print "[1] Potion (20g)  [2] ATK +2 (40g)  [3] Leave"
        let choice = input "> "
        if choice == 1 {
            if p.gold < 20 { print ">> Not enough gold!" continue }
            p.gold -= 20
            p.potions += 1
            print ">> Bought a potion! (you have {p.potions})"
        } else if choice == 2 {
            if p.gold < 40 { print ">> Not enough gold!" continue }
            p.gold -= 40
            p.atk += 2
            print ">> Your ATK is now {p.atk}!"
        } else if choice == 3 {
            return 0
        } else {
            print ">> Pick 1, 2 or 3"
        }
    }
}

func load_game() {
    let f = split(readfile("save.txt"), ",")
    let p = Player(f[1])
    p.level = num(f[2])
    p.exp = num(f[3])
    p.maxhp = num(f[4])
    p.hp = num(f[5])
    p.atk = num(f[6])
    p.gold = num(f[7])
    p.potions = num(f[8])
    print ">> Loaded: {p.name} (Lv.{p.level})"
    return p
}

# ================= the game starts =================
print "================================"
print "   Dungeon of Venos  (text RPG)"
print "================================"
print "[1] New game  [2] Load"
let start = input "> "
let p = 0
if start == 2 and not exists("save.txt") {
    print ">> No save file found — starting a new game."
    start = 1
}
if start == 2 {
    p = load_game()
} else {
    let name = input "What is your hero's name? > "
    p = Player(name)
    print ""
    print "Welcome to the dungeon, {name}!"
    print "Reach Lv.4 to challenge its master, the Black Flame Dragon."
}

let playing = true
while playing {
    print ""
    print "========== Village =========="
    print "[1] Explore  [2] Stats  [3] Shop  [4] Save  [5] Quit"
    if p.level >= 4 { print "[6] * Challenge the boss *" }
    let choice = input "> "

    if choice == 1 {
        let m = spawn_monster(p.level)
        battle(p, m)
        if p.hp <= 0 {
            print ""
            print "vv {p.name} has fallen... GAME OVER vv"
            playing = false
        }
    } else if choice == 2 {
        p.stats()
    } else if choice == 3 {
        shop(p)
    } else if choice == 4 {
        p.save_game()
    } else if choice == 5 {
        print ""
        print "See you next time, {p.name}!"
        playing = false
    } else if choice == 6 and p.level >= 4 {
        let boss_template = {"name": "Black Flame Dragon", "hp": 130, "atk": 16, "gold": 300, "exp": 100}
        let boss = Monster(boss_template, 0)
        if battle(p, boss) {
            print ""
            print "********************************"
            print " The dragon falls! DUNGEON CLEAR!"
            print " Final: Lv.{p.level} / {p.gold} gold"
            print "********************************"
            playing = false
        } else if p.hp <= 0 {
            print ""
            print "vv You fell before the dragon... GAME OVER vv"
            playing = false
        }
    } else {
        print ">> Pick a menu number"
    }
}
print ""
print "(The adventure ends here)"
